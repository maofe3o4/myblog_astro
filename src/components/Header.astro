---
import { SITE, NAV, TYPE_LABEL } from '../site.config';
import { getPosts } from '../lib/posts';
import SettingsPanel from './SettingsPanel.astro';

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}

// 内联搜索索引（标题 / 摘要 / 标签 / 分类 / 类型）
const searchIndex = (await getPosts()).map((p) => {
  const d = p.data.pubDate;
  return {
    title: p.data.title,
    url: `/blog/${p.id}/`,
    description: p.data.description ?? '',
    tags: p.data.tags,
    category: p.data.category ?? '',
    type: TYPE_LABEL[p.data.type],
    date: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`,
  };
});
---

<header class="site-header" transition:persist>
  <div class="container">
    <div class="navbar">
      <a href="/" class="brand" aria-label={SITE.name}>
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span class="brand__name">{SITE.name}</span>
      </a>

      <nav class="nav" aria-label="主导航">
        <span class="nav__indicator" aria-hidden="true"></span>
        {NAV.map((item) => (
          <a href={item.href} class:list={['nav__link', isActive(item.href) && 'is-active']}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="actions">
        <div class="search" id="search-box">
          <input id="site-search" class="search-input" type="search" placeholder="搜索…" autocomplete="off" aria-label="搜索文章" />
          <button id="search-toggle" class="icon-btn" type="button" aria-label="搜索文章" title="搜索文章" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7" />
              <path d="M21 21l-4.3-4.3" />
            </svg>
          </button>

          <div id="search-pop" class="search-pop" hidden>
            <ul id="search-results" class="search-results" hidden></ul>
            <p id="search-empty" class="search-empty" hidden>没有找到相关文章</p>
          </div>
        </div>

        <span class="divider" aria-hidden="true"></span>

        <SettingsPanel />

        <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换主题" title="切换明暗主题">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)}></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.7rem 0 0.4rem;
    pointer-events: none;
  }
  .site-header .container { pointer-events: auto; }

  /* ---------- 玻璃胶囊导航栏（宽度自适应内容） ---------- */
  .navbar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 54px;
    padding: 0 0.75rem 0 1.1rem;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 55%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border: 1px solid color-mix(in srgb, var(--border-strong) 55%, transparent);
    box-shadow: 0 8px 30px rgba(15, 12, 40, 0.14), inset 0 1px 0 color-mix(in srgb, white 22%, transparent);
    transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    font-weight: 700;
    flex-shrink: 0;
  }
  .brand:hover { color: var(--text); }
  .brand__name { font-family: var(--font-serif); font-size: 1.15rem; }

  .nav {
    position: relative;
    display: flex;
    gap: 0.15rem;
    align-items: center;
    margin-left: 0.4rem;
  }
  /* 选中态滑动药丸：随 .is-active 切换平滑滑动到当前导航项 */
  .nav__indicator {
    position: absolute;
    top: 50%;
    left: 0;
    height: 30px;
    width: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--brand) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 28%, transparent);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: transform 0.42s cubic-bezier(0.34, 1.2, 0.64, 1),
                width 0.42s cubic-bezier(0.34, 1.2, 0.64, 1),
                opacity 0.3s ease;
    will-change: transform, width;
  }
  .nav__link {
    position: relative;
    z-index: 1;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.93rem;
    font-weight: 500;
    transition: color var(--transition), background var(--transition);
  }
  .nav__link:hover { color: var(--text); background: color-mix(in srgb, var(--surface-2) 70%, transparent); }
  .nav__link.is-active {
    color: var(--brand);
    background: transparent;
  }

  /* ---------- 右侧操作区（紧邻导航项，不再顶到右端） ---------- */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .divider {
    width: 1px;
    height: 20px;
    background: color-mix(in srgb, var(--border-strong) 70%, transparent);
    margin: 0 0.25rem;
  }
  .icon-moon { display: none; }
  :root[data-theme='dark'] .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon { display: block; }

  /* ---------- 内嵌搜索：输入框在导航栏内展开 ---------- */
  .search { position: relative; display: flex; align-items: center; }
  .search-input {
    width: 0;
    height: 34px;
    padding: 0;
    opacity: 0;
    border: none;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    outline: none;
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s, padding 0.35s cubic-bezier(0.4, 0, 0.2, 1), margin 0.35s;
  }
  .search-input::placeholder { color: var(--text-muted); }
  .search.is-open .search-input {
    width: 190px;
    opacity: 1;
    padding: 0 0.9rem;
    margin-right: 0.35rem;
  }

  .search-pop {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    width: min(88vw, 340px);
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgba(15, 12, 40, 0.2);
    overflow: hidden;
    z-index: 60;
  }
  .search-results { list-style: none; margin: 0; padding: 0.4rem; max-height: 55vh; overflow-y: auto; }
  .search-results a {
    display: block;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius-sm);
    color: inherit;
  }
  .search-results a:hover { background: var(--surface-2); }
  .search-results__title { font-family: var(--font-serif); font-weight: 600; font-size: 0.95rem; }
  .search-results a:hover .search-results__title { color: var(--brand); }
  .search-results__meta { font-size: 0.76rem; color: var(--text-muted); margin-top: 0.15rem; }
  .search-results__cat { color: var(--c2); font-weight: 700; }
  .search-empty { margin: 0; padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.88rem; }

  @media (max-width: 640px) {
    .navbar { gap: 0.5rem; padding: 0 0.5rem 0 0.9rem; }
    .nav__link { padding: 0.35rem 0.55rem; font-size: 0.88rem; }
    .search.is-open .search-input { width: 120px; }
  }
</style>

