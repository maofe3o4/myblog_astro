---
import type { CollectionEntry } from 'astro:content';
import { tagColorIndex } from '../lib/posts';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  entry: CollectionEntry<'blog'>;
  /** card=列表缩略，banner=详情页大图，thumb=小缩略（不渲染占位标题） */
  variant?: 'card' | 'banner' | 'thumb';
}

const { entry, variant = 'card' } = Astro.props;
const { cover, title, tags = [] } = entry.data;
const ci = tagColorIndex(tags[0] ?? title);

// 未指定封面时，从 public/covers 按文章 id 确定性随机取一张
// （用 id 做哈希，保证同一篇文章在列表/详情页拿到的是同一张，而不是每次渲染都变）
let resolvedCover = cover;
if (!resolvedCover) {
  try {
    const dir = path.join(process.cwd(), 'public/covers');
    const files = fs
      .readdirSync(dir)
      .filter((f) => /\.(png|jpe?g|webp|gif|svg)$/i.test(f));
    if (files.length) {
      // FNV-1a 哈希：分布更均匀，避免多篇文章撞同一张
      let h = 2166136261;
      for (const ch of entry.id) {
        h ^= ch.charCodeAt(0);
        h = Math.imul(h, 16777619);
      }
      resolvedCover = `/covers/${files[(h >>> 0) % files.length]}`;
    }
  } catch {
    /* 目录不存在或无图时维持渐变占位 */
  }
}
---

{
  resolvedCover ? (
    <img class:list={['cover', `cover--${variant}`]} src={resolvedCover} alt={title} loading="lazy" />
  ) : (
    <div
      class:list={['cover', 'cover--ph', `cover--${variant}`]}
      style={`--cv: var(--c${ci});`}
      aria-hidden="true"
    >
      {variant !== 'thumb' && <span class="cover__ph-title">{title}</span>}
      <span class="cover__ph-mark">六</span>
    </div>
  )
}

<style>
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .cover--banner { aspect-ratio: 21 / 9; }
  .cover--thumb { aspect-ratio: 16 / 10; border-radius: var(--radius-sm); }

  .cover--ph {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 20% 10%, color-mix(in srgb, var(--cv) 85%, #fff) 0%, transparent 55%),
      linear-gradient(135deg, var(--cv), color-mix(in srgb, var(--cv) 45%, #14122a));
    color: #fff;
  }
  .cover__ph-title {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.4vw, 1.5rem);
    font-weight: 600;
    text-align: center;
    padding: 0 1.2rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
    line-height: 1.35;
    z-index: 1;
  }
  .cover__ph-mark {
    position: absolute;
    right: -0.3rem;
    bottom: -1.6rem;
    font-family: var(--font-serif);
    font-size: 7rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.16);
    line-height: 1;
  }
  .cover--thumb .cover__ph-mark {
    font-size: 3.5rem;
    right: -0.4rem;
    bottom: -1.2rem;
  }
</style>
