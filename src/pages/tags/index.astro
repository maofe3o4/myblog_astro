---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagMap, slugifyTag } from '../../lib/posts';

const tagMap = await getTagMap();
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <div class="page-head">
    <h1>标签</h1>
    <p class="muted">共 {tags.length} 个标签</p>
  </div>

  <div class="tag-cloud">
    {tags.map(([tag, count], i) => (
      <a href={`/tags/${slugifyTag(tag)}/`} class="tag tag--lg" data-index={i % 6}>
        {tag} <span class="tag__count">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .page-head { margin-bottom: 1.6rem; }
  .page-head p { margin: 0.3rem 0 0; }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .tag--lg { font-size: 0.95rem; padding: 0.4em 0.9em; }
  .tag__count {
    opacity: 0.7;
    font-size: 0.8em;
    margin-left: 0.2em;
  }
</style>
